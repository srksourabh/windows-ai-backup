{
  "catalog_version": 1,
  "tools": [
    {
      "id": "antigravity",
      "name": "Google Antigravity",
      "category": "AI IDE",
      "detect": [
        "~/.antigravity",
        "%APPDATA%/Antigravity"
      ],
      "items": [
        {
          "path": "~/.antigravity/rules",
          "kind": "prompt",
          "note": "Global rules",
          "include": [
            "**/*.md",
            "**/*.mdc"
          ]
        },
        {
          "path": "~/.antigravity/argv.json",
          "kind": "config"
        },
        {
          "path": "%APPDATA%/Antigravity/User/settings.json",
          "kind": "config"
        },
        {
          "path": "%APPDATA%/Antigravity/User/keybindings.json",
          "kind": "config"
        },
        {
          "path": "%APPDATA%/Antigravity/User/snippets",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60
        },
        {
          "path": "%APPDATA%/Antigravity IDE/User/settings.json",
          "kind": "config"
        },
        {
          "path": "~/.gemini/antigravity/mcp_config.json",
          "kind": "config",
          "note": "Antigravity MCP servers"
        },
        {
          "path": "~/.gemini/antigravity-cli",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "note": "Antigravity CLI config",
          "include": [
            "**/*.json",
            "**/*.yaml",
            "**/*.yml",
            "**/*.toml",
            "**/*.md"
          ]
        }
      ],
      "mcp_sources": [
        {
          "path": "~/.gemini/antigravity/mcp_config.json",
          "fmt": "mcp_servers",
          "client": "Antigravity"
        }
      ],
      "install": {
        "url": "https://antigravity.google/download"
      },
      "extensions_dir": "~/.antigravity/extensions"
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "category": "AI IDE",
      "detect": [
        "~/.cursor",
        "%APPDATA%/Cursor"
      ],
      "items": [
        {
          "path": "~/.cursor/mcp.json",
          "kind": "config",
          "note": "MCP servers"
        },
        {
          "path": "~/.cursor/cli-config.json",
          "kind": "config"
        },
        {
          "path": "~/.cursor/rules",
          "kind": "prompt",
          "note": "Global rules",
          "include": [
            "**/*.md",
            "**/*.mdc"
          ]
        },
        {
          "path": "~/.cursor/agents",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "note": "Custom agents",
          "include": [
            "**/*.md",
            "**/*.json"
          ]
        },
        {
          "path": "~/.cursor/skills-cursor",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "note": "Skills"
        },
        {
          "path": "~/.cursor/plugins",
          "kind": "tree",
          "note": "Plugin settings",
          "include": [
            "*.json",
            "*/*.json"
          ],
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 10
        },
        {
          "path": "~/.cursor/plugins/marketplaces",
          "kind": "record",
          "note": "Plugin payloads — re-cloned"
        },
        {
          "path": "%APPDATA%/Cursor/User/settings.json",
          "kind": "config",
          "note": "Editor and AI settings"
        },
        {
          "path": "%APPDATA%/Cursor/User/keybindings.json",
          "kind": "config"
        },
        {
          "path": "%APPDATA%/Cursor/User/snippets",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60
        },
        {
          "path": "~/.cursor/extensions",
          "kind": "record",
          "note": "Extensions — reinstalled by id"
        },
        {
          "path": "~/.cursor/chats",
          "kind": "record",
          "note": "Chat history"
        }
      ],
      "mcp_sources": [
        {
          "path": "~/.cursor/mcp.json",
          "fmt": "mcp_servers",
          "client": "Cursor"
        }
      ],
      "install": {
        "winget": "Anysphere.Cursor",
        "url": "https://cursor.com/download"
      },
      "extensions_dir": "~/.cursor/extensions"
    },
