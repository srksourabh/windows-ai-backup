{
  "catalog_version": 1,
  "tools": [
    {
      "id": "aider",
      "name": "Aider",
      "category": "Agent CLI",
      "detect": [
        "~/.aider.conf.yml",
        "~/.aider.model.settings.yml"
      ],
      "items": [
        {
          "path": "~/.aider.conf.yml",
          "kind": "config",
          "note": "Default model and flags"
        },
        {
          "path": "~/.aider.model.settings.yml",
          "kind": "config",
          "note": "Per-model settings"
        },
        {
          "path": "~/.aider.model.metadata.json",
          "kind": "config"
        }
      ],
      "install": {
        "pipx": "aider-chat",
        "uv": "aider-chat",
        "docs": "https://aider.chat/docs"
      }
    },
    {
      "id": "amazon-q",
      "name": "Amazon Q Developer",
      "category": "Agent CLI",
      "detect": [
        "~/.aws/amazonq"
      ],
      "items": [
        {
          "path": "~/.aws/amazonq/mcp.json",
          "kind": "config",
          "note": "MCP servers"
        },
        {
          "path": "~/.aws/amazonq/global_context.json",
          "kind": "config"
        },
        {
          "path": "~/.aws/amazonq/profiles",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "include": [
            "**/*.json",
            "**/*.md"
          ]
        },
        {
          "path": "~/.aws/amazonq/cli-agents",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "note": "Custom agents",
          "include": [
            "**/*.json"
          ]
        }
      ],
      "mcp_sources": [
        {
          "path": "~/.aws/amazonq/mcp.json",
          "fmt": "mcp_servers",
          "client": "Amazon Q"
        }
      ],
      "install": {
        "docs": "https://docs.aws.amazon.com/amazonq/"
      }
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "category": "Agent CLI",
      "detect": [
        "~/.claude",
        "~/.claude.json"
      ],
      "items": [
        {
          "path": "~/.claude.json",
          "kind": "config",
          "note": "Global config: MCP servers, account, per-project settings"
        },
        {
          "path": "~/.claude/settings.json",
          "kind": "config",
          "note": "Permissions, plugins, statusline, effort level"
        },
        {
          "path": "~/.claude/settings.local.json",
          "kind": "config",
          "note": "Machine-local overrides"
        },
        {
          "path": "~/.claude/CLAUDE.md",
          "kind": "prompt",
          "note": "Global master prompt"
        },
        {
          "path": "~/CLAUDE.md",
          "kind": "prompt",
          "note": "Home-scope master prompt"
        },
        {
          "path": "~/.claude/rules",
          "kind": "prompt",
          "note": "Rule set loaded into every session",
          "include": [
            "**/*.md"
          ]
        },
        {
          "path": "~/.claude/agents",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "note": "Custom subagent definitions",
          "include": [
            "**/*.md"
          ]
        },
        {
          "path": "~/.claude/commands",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "note": "Custom slash commands",
          "include": [
            "**/*.md"
          ]
        },
        {
          "path": "~/.claude/skills",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 200,
          "note": "Custom and installed skills"
        },
        {
          "path": "~/.claude/local-plugins",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "note": "Locally authored plugins"
        },
        {
          "path": "~/.claude/scripts",
          "kind": "tree",
          "exclude": [
            "**/node_modules/**",
            "**/.git/**",
            "**/__pycache__/**",
            "**/*.log",
            "**/cache/**"
          ],
          "max_total_mb": 60,
          "note": "Helper scripts referenced by hooks and statusline"
        },
        {
          "path": "~/.claude/statusline-command.js",
          "kind": "config"
        },
        {
          "path": "~/.claude/statusline-command.ps1",
          "kind": "config"
        },
        {
          "path": "~/.claude/statusline-command.sh",
          "kind": "config"
        },
        {
          "path": "~/.claude/keybindings.json",
          "kind": "config"
        },
        {
          "path": "~/.claude/mcp_config.json",
          "kind": "config",
          "note": "Standalone MCP config"
        },
        {
          "path": "~/.claude/claude_desktop_config.json",
          "kind": "config",
          "note": "Desktop MCP config staged by the CLI"
        },
        {
          "path": "~/.claude/plugins/installed_plugins.json",
          "kind": "config",
          "note": "Enabled plugins, restored by name"
        },
        {
          "path": "~/.claude/plugins/known_marketplaces.json",
          "kind": "config",
          "note": "Plugin marketplace sources"
        },
        {
          "path": "~/.claude/plugins/config.json",
          "kind": "config"
        },
        {
          "path": "~/.claude/skills-lock.json",
          "kind": "config",
          "note": "Pinned skill versions"
        },
        {
          "path": "~/.claude/projects",
          "kind": "prompt",
          "note": "Per-project auto-memory",
          "include": [
            "**/memory/**/*.md"
          ]
        },
        {
          "path": "~/.claude/.credentials.json",
          "kind": "secret",
          "note": "OAuth tokens and API key"
        },
        {
          "path": "~/.claude/plugins/cache",
          "kind": "record",
          "note": "Plugin payloads — re-cloned from marketplaces"
        },
        {
          "path": "~/.claude/projects",
          "kind": "record",
          "note": "Session transcripts — not needed for a fresh setup"
        }
      ],
      "mcp_sources": [
        {
          "path": "~/.claude.json",
          "fmt": "claude_json",
          "client": "Claude Code"
        },
        {
          "path": "~/.claude/mcp_config.json",
          "fmt": "mcp_servers",
          "client": "Claude Code"
        }
      ],
      "install": {
        "npm": "@anthropic-ai/claude-code",
        "docs": "https://docs.claude.com/en/docs/claude-code",
        "note": "Native installer: irm https://claude.ai/install.ps1 | iex"
      }
    },
    {
      "id": "cline-cli",
      "name": "Cline CLI",
      "category": "Agent CLI",
      "detect": [
        "~/.cline"
